ARG APP_BINARY=mw-kube-agent

# Generate OBI's eBPF files (*_bpfel.go, *_bpfel.o) in the .obi-src submodule.
# It generates both amd64 and arm64, so it runs on the build platform.
# The image version must match GEN_IMG in .obi-src/Makefile.
FROM --platform=$BUILDPLATFORM ghcr.io/open-telemetry/obi-generator:0.2.17 AS bpf-generator
WORKDIR /src/.obi-src
COPY .obi-src .
RUN /generate.sh

# Only mw-kube-agent imports OBI. opsai and synthetics get an empty folder,
# so Docker skips the bpf-generator stage for them.
FROM --platform=$BUILDPLATFORM golang:1.26.0 AS obi-skip
RUN mkdir -p /src/.obi-src

FROM bpf-generator AS obi-mw-kube-agent
FROM obi-skip AS obi-mw-opsai
FROM obi-skip AS obi-mw-synthetics
FROM obi-${APP_BINARY} AS obi

# Stage 1: Build Stage
# Use BUILDPLATFORM so Go compiles natively on the runner's arch (x86_64),
# then cross-compile for TARGETARCH via GOOS/GOARCH — no QEMU needed.
FROM --platform=$BUILDPLATFORM golang:1.26.0 AS build

ARG TARGETARCH
ARG TARGETOS=linux
ARG GITHUB_TOKEN

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates openssl && \
    update-ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Set up private repo access before downloading modules
RUN git config --global url."https://${GITHUB_TOKEN}:x-oauth-basic@github.com/".insteadOf "https://github.com/"

COPY go.mod go.sum ./
# go.mod replaces go.opentelemetry.io/obi with ./.obi-src, so download needs its go.mod.
COPY .obi-src/go.mod .obi-src/go.sum ./.obi-src/
ENV GOPRIVATE=github.com/middleware-labs
RUN go mod download

COPY . .
COPY --from=obi /src/.obi-src ./.obi-src

# Set up environment variables for build
ENV CGO_ENABLED=0
ARG GITHUB_TOKEN
RUN GOPRIVATE=github.com/middleware-labs go mod tidy

# Build the Go binary
ARG AGENT_VERSION
ARG APP_BINARY
RUN AGENT_FOLDER="$(echo $APP_BINARY | sed 's/^mw-//')" && \
    SRC="cmd/${AGENT_FOLDER}/main.go" && \
    if [ ! -f "$SRC" ]; then echo "Source file $SRC does not exist!" && exit 1; fi && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
      -ldflags "-s -w -X main.agentVersion=${AGENT_VERSION}" \
      -o /tmp/mw-agent "$SRC"

# Stage 2: Production Stage
FROM ubuntu:24.04 AS prod
RUN apt-get update && apt-get install -y --no-install-recommends systemd ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

ARG TARGETARCH
ARG APP_BINARY
RUN if [ "$APP_BINARY" = "mw-opsai" ]; then \
    curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/${TARGETARCH}/kubectl" && \
    install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl && \
    rm kubectl; \
fi

# Copy necessary files from the build stage
COPY --from=build /etc/ssl/certs /etc/ssl/certs
COPY --from=build /tmp/mw-agent /usr/bin/mw-agent
COPY --from=build /app/configyamls-k8s/*.yaml /app/

# Create symlink for backward compatibility
RUN ln -s /usr/bin/mw-agent /usr/bin/api-server

# Final command
CMD ["mw-agent", "start"]
